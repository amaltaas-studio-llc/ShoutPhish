{
  "name": "shoutphish",
  "version": "0.16.1",
  "private": true,
  "description": "Phishing checks for Gmail that explain every point of the score. Runs in your browser, with no network requests by default.",
  "license": "MIT",
  "author": "Amaltaas Studio LLC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "dev": "node scripts/build.mjs --dev --watch",
    "harness": "node scripts/harness.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "store:images": "node scripts/store-images.mjs",
    "clean": "node scripts/build.mjs --clean-only",
    "check:dist": "node scripts/check-dist.mjs && node scripts/check-dist.mjs --target=firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --warnings-as-errors",
    "smoke:browsers": "npm run build && npm run build:firefox && node scripts/browser-smoke.mjs",
    "smoke:docker": "node scripts/browser-smoke.mjs --docker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "node scripts/eval.mjs",
    "eval:prompts": "node scripts/export-semantic-eval.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:firefox && npm run check:dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  }
}
